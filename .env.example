# ── Public (safe to expose) ──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://pilk.ai
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Stripe (only the webhook for hosting plans started at the former checkout;
#    there is no online checkout any more: /api/checkout answers 410) ──
# Secret key — set as an encrypted secret, NOT in git:
#   npx wrangler pages secret put STRIPE_SECRET_KEY --project-name pilk-ai-media
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe webhook endpoint (whsec_...):
#   npx wrangler pages secret put STRIPE_WEBHOOK_SECRET --project-name pilk-ai-media
STRIPE_WEBHOOK_SECRET=
# Optional: the recurring hosting Price ID those plans use. If blank, the webhook
# finds or creates one via lookup_key "pilk_hosting_monthly".
STRIPE_PRICE_MONTHLY=

# ── Lead storage (optional — app runs without it) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Transactional email (optional) ───────────────────────
RESEND_API_KEY=
LEADS_NOTIFICATION_EMAIL=
LEADS_FROM_EMAIL=

# ── GoHighLevel (form leads → GHL CRM) ───────────────────
# Private Integration Token (secret) — set with wrangler, NOT in git:
#   npx wrangler pages secret put GHL_PIT_TOKEN --project-name pilk-ai-media
GHL_PIT_TOKEN=
# The GHL sub-account (location) ID the leads should land in, and the PILK AI
# pipeline/stage ids. Production values live in wrangler.toml [vars];
# docs/integrations/ghl.md explains them and the token scopes needed.
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_NEW_LEAD=
GHL_STAGE_INTAKE_COMPLETED=
GHL_STAGE_LOST=
GHL_STAGE_ORDER=

# ── CRM + spam + rate limiting (optional) ────────────────
# Per-IP limit on accepted form submissions (Cache API); defaults 5 per 600 s.
FORM_RATE_LIMIT_MAX=
FORM_RATE_LIMIT_WINDOW_SECONDS=
CRM_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare BINDINGS (not plain env vars) ─────────────
# Configure these in the Cloudflare Pages dashboard, not in this file:
#   R2 bucket binding name: PROJECT_UPLOADS  (private bucket for brief uploads)
# Settings → Functions → R2 bucket bindings → add binding "PROJECT_UPLOADS"
# (Text-only briefs work without it; uploads require it.)
